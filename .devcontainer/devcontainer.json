{
  "name": "Shared Cloud Dev Workspace",
  "postCreateCommand": "npm install -g @opencode/cli",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js development server",
      "onAutoForward": "notify"
    }
  }
}
