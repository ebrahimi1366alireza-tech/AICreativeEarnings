{
  "name": "AI Creative Earnings - Cloud Workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [3000, 4096],
  "portsAttributes": {
    "3000": { "label": "AI Creative Earnings", "onAutoForward": "openBrowser", "visibility": "private" },
    "4096": { "label": "OpenCode Web", "onAutoForward": "notify", "visibility": "private" }
  },
  "postCreateCommand": "npm install --global @opencode/cli",
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
