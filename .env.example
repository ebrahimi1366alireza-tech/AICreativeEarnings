# Server-only credentials. Never prefix these with NEXT_PUBLIC_ and never bundle them in the APK.
OPENAI_API_KEY=
# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Server-only Supabase service-role key for atomic usage accounting. Never expose to browser/APK.
SUPABASE_SERVICE_ROLE_KEY=
# Daily credits per user (text = 1, image = 5). Default: 10.
CREATIVE_DAILY_CREDITS=10

# Runway Dev API: separate billing from the Runway consumer app. Keep server-side only.
RUNWAYML_API_SECRET=
